---
import { getPlan, listAssessments, listCourses } from "../lib/db";
import { computeAssessmentPressure } from "../lib/pressure";
import "../styles.css";

const courses = listCourses();
const assessments = listAssessments();
const plan = getPlan();

const saved = Astro.url.searchParams.get("saved") === "1";
const error = Astro.url.searchParams.get("error");

const ERROR_MESSAGES: Record<string, string> = {
  unknown_course: "That course code isn't recognised.",
  duplicate_current: "Each course can only be selected once.",
  candidate_conflict: "The candidate course can't also be one of your current courses.",
  multiple_candidates: "Choose only one candidate course.",
  malformed: "Something went wrong reading that submission.",
};
const errorMessage = error ? (ERROR_MESSAGES[error] ?? "That plan couldn't be saved.") : null;

const pressure = computeAssessmentPressure(assessments, plan.current, plan.candidate);
// Bars scale against 100 (a whole course's assessment weight) by default, but
// stretch further if a period's combined total genuinely exceeds it — real
// clash, never clipped away.
const scale = Math.max(100, ...pressure.periods.map((period) => period.withCandidateTotal));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CLASH</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">CLASH</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <header class="hero">
        <h1>CLASH</h1>
        <p class="tagline">A course can fit your timetable and still not fit your semester.</p>
        <p class="supporting">See where assessment weight piles up before another course joins your plan.</p>
      </header>

      <form method="post" action="/api/plan" class="plan-form">
        <fieldset>
          <legend>MY SEMESTER</legend>
          <p class="hint">Select every course you're currently taking.</p>
          <div class="course-grid">
            {
              courses.map((course) => {
                const checked = plan.current.includes(course.code);
                return (
                  <label class:list={["course-card", { selected: checked }]}>
                    <input type="checkbox" name="current" value={course.code} checked={checked} />
                    <span class="course-code">{course.code}</span>
                    <span class="course-title">{course.title}</span>
                  </label>
                );
              })
            }
          </div>
        </fieldset>

        <fieldset>
          <legend>CONSIDERING</legend>
          <p class="hint">Pick at most one candidate course to compare against your current semester.</p>
          <label for="candidate">Candidate course</label>
          <select id="candidate" name="candidate">
            <option value="">— No candidate —</option>
            {
              courses
                .filter((course) => !plan.current.includes(course.code))
                .map((course) => (
                  <option value={course.code} selected={plan.candidate === course.code}>
                    {course.code} — {course.title}
                  </option>
                ))
            }
          </select>
        </fieldset>

        <button type="submit">SAVE MY PLAN</button>
        {saved && (
          <p class="confirmation" role="status">
            Plan saved.
          </p>
        )}
        {errorMessage && (
          <p class="error" role="alert">
            {errorMessage}
          </p>
        )}
      </form>

      <section class="pressure">
        <p class="plan-status">Showing your saved plan. Save changes to recalculate.</p>
        <h2>ASSESSMENT PRESSURE</h2>
        <p class="hint">Assessment weight due across selected courses, by semester period.</p>
        <div class="legend">
          <span class="legend-item"><span class="swatch current" /> Current</span>
          <span class="legend-item"><span class="swatch with-candidate" /> Current + candidate</span>
        </div>

        {
          pressure.periods.length === 0 ? (
            <p>No selected course has assessments mapped to a semester period yet.</p>
          ) : (
            <ol class="week-list">
              {pressure.periods.map((period) => {
                const isHighest = pressure.highestPressure?.key === period.key;
                const delta = period.withCandidateTotal - period.currentTotal;
                return (
                  <li class:list={["week-row", { worst: isHighest }]}>
                    <div class="week-label">
                      {period.label}
                      {isHighest && <span class="worst-badge">HIGHEST PRESSURE</span>}
                    </div>
                    <div class="bars">
                      <div class="bar-track">
                        <div class="bar current" style={`width: ${(period.currentTotal / scale) * 100}%`} />
                      </div>
                      <div class="bar-track">
                        <div class="bar with-candidate" style={`width: ${(period.withCandidateTotal / scale) * 100}%`} />
                      </div>
                    </div>
                    <div class="week-totals">
                      <span>Current: {period.currentTotal}%</span>
                      <span>
                        With candidate: {period.withCandidateTotal}%
                        {delta > 0 && ` (+${delta} percentage points)`}
                      </span>
                    </div>
                  </li>
                );
              })}
            </ol>
          )
        }

        {
          pressure.unmapped.length > 0 && (
            <div class="unmapped">
              <h3>Outside the modelled calendar</h3>
              <p class="hint">
                Timing that can't be honestly placed on the semester calendar — unstated, or outside the modelled
                range entirely — never discarded, shown here instead.
              </p>
              <ul>
                {pressure.unmapped.map((item) => (
                  <li>
                    <strong>{item.courseId}</strong> — {item.title} ({item.weight}%): {item.timingLabel}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </section>
    </main>
    <script>
      // Minimal client-side consistency check, not a reactive frontend: the
      // pressure chart above still only reflects the last SAVED plan (see the
      // "Showing your saved plan" text) and does not recompute here. This
      // only stops a course from being simultaneously checked under MY
      // SEMESTER and left selectable as the candidate before you save.
      const currentInputs = document.querySelectorAll<HTMLInputElement>('input[name="current"]');
      const candidateSelect = document.getElementById("candidate") as HTMLSelectElement | null;

      function syncCandidateOptions() {
        if (!candidateSelect) return;
        const checked = new Set([...currentInputs].filter((input) => input.checked).map((input) => input.value));
        for (const option of candidateSelect.options) {
          option.disabled = checked.has(option.value);
        }
        if (candidateSelect.value && checked.has(candidateSelect.value)) {
          candidateSelect.value = "";
        }
      }

      for (const input of currentInputs) {
        input.addEventListener("change", syncCandidateOptions);
      }
      syncCandidateOptions();
    </script>
  </body>
</html>
